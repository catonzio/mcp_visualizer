    "version": "0.2.0",
    "configurations": [
        {
            "name": "mcp_visualizer",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
        },
        {
            "name": "mcp_visualizer (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "mcp_visualizer (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "mcp_visualizer web (debug)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "-d",
                "chrome",
                "--web-browser-flag",
                "--disable-web-security",
                "--web-experimental-hot-reload",
                "--web-port",
                "7357"
            ]
        }
    ]
}